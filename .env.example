EXASPIM_ENVIRONMENT=dev
EXASPIM_LOCAL_JSON_PATH=data/sample/local_records.json
EXASPIM_SQLITE_PATH=exports/exaspim_agent.db
EXASPIM_RETRIEVAL_TOP_K=6
EXASPIM_CHUNK_SIZE=900
EXASPIM_CHUNK_OVERLAP=120
EXASPIM_SMARTSHEET_API_TOKEN=
EXASPIM_SMARTSHEET_TOKEN_FILE=CO_API/CO_ACCESS_TOKEN.txt
EXASPIM_SMARTSHEET_SHEET_IDS=[]
EXASPIM_SMARTSHEET_SHEETS=[]
EXASPIM_TEAMS_TENANT_ID=
EXASPIM_TEAMS_CLIENT_ID=
EXASPIM_TEAMS_CLIENT_SECRET=
EXASPIM_TEAMS_TOKEN_FILE=
EXASPIM_TEAMS_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
EXASPIM_TEAMS_AUTHORITY_URL=https://login.microsoftonline.com
EXASPIM_TEAMS_SCOPE=https://graph.microsoft.com/.default
EXASPIM_TEAMS_MAX_MESSAGES_PER_CHANNEL=100
EXASPIM_TEAMS_CHANNELS=[]
EXASPIM_AWS_REGION=us-west-2
EXASPIM_S3_BUCKET=
EXASPIM_S3_PREFIXES=[]
EXASPIM_OPENAI_API_KEY=

# --- Code Ocean (AIND deployment) ---
# Token via file (preferred) or inline. The file path must stay gitignored.
EXASPIM_CODE_OCEAN_API_TOKEN=
EXASPIM_CODE_OCEAN_TOKEN_FILE=secrets/codeocean_api_token
EXASPIM_CODE_OCEAN_BASE_URL=https://codeocean.allenneuraldynamics.org/api/v1
# JSON array: [{"key":"snapshot","capsule_id":"<uuid>","name":"...","description":"..."}]
EXASPIM_CODE_OCEAN_CAPSULES=[]
EXASPIM_CODE_OCEAN_MAX_COMPUTATIONS=10
# Launching runs is OFF by default. Set true only where spending money is intended.
EXASPIM_CODE_OCEAN_ALLOW_LAUNCH=false

# --- Neuron Morphology Community Portal (NMCP) ---
# Optional: published specimens are visible anonymously; a token unlocks private records.
EXASPIM_MORPHOLOGY_PORTAL_API_TOKEN=
EXASPIM_MORPHOLOGY_PORTAL_TOKEN_FILE=secrets/nmcp_api_token
EXASPIM_MORPHOLOGY_PORTAL_BASE_URL=https://morphology.allenneuraldynamics.org/graphql
EXASPIM_MORPHOLOGY_PORTAL_COLLECTION_FILTER=
EXASPIM_MORPHOLOGY_PORTAL_MAX_SPECIMENS=500
